# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./memora.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/memora_db

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=memora_memories

# LLM Providers (openai | gemini | grok | local_heuristic)
LLM_PROVIDER=local_heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# Security
JWT_SECRET=memora_super_secret_jwt_key_hackclub_2026_change_in_production
ENVIRONMENT=development
